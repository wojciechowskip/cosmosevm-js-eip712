{
  "name": "cosmos-js-eip712-kii",
  "version": "0.0.1",
  "description": "EIP-712 typed-data builder for signing Cosmos SDK authz/feegrant messages with an EVM wallet (MetaMask) on KiiChain and other cosmos/evm-based chains",
  "author": "patrykw <patryk.wojciechowski.dev@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/wojciechowskip/cosmos-js-eip712-kii",
  "repository": {
    "type": "git",
    "url": "https://github.com/wojciechowskip/cosmos-js-eip712-kii"
  },
  "keywords": [
    "cosmos",
    "eip712",
    "eth_signTypedData_v4",
    "metamask",
    "kiichain",
    "cosmos-evm",
    "authz",
    "feegrant"
  ],
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@cosmjs/encoding": "^0.32.4",
    "@metamask/eth-sig-util": "^9.0.0",
    "cosmjs-types": "^0.9.0",
    "ethers": "^6.13.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
